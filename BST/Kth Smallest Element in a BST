# CODE:

```java
/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public int kthSmallest(TreeNode root, int k) {
        TreeNode curr = root;
        int cnt = 0;
        int result = -1;

        // Morris Inorder Traversal
        while (curr != null) {
            if (curr.left == null) {
                // Visit current node
                cnt++;
                if (cnt == k) result = curr.val;
                
                curr = curr.right;
            } else {
                // Find the inorder predecessor of curr
                TreeNode prev = curr.left;
                while (prev.right != null && prev.right != curr) {
                    prev = prev.right;
                }

                if (prev.right == null) {
                    // Create thread to curr and move left
                    prev.right = curr;
                    curr = curr.left;
                } else {
                    // Revert thread, visit current node, move right
                    prev.right = null;
                    cnt++;
                    if (cnt == k) result = curr.val;
                    
                    curr = curr.right;
                }
            }
        }
        
        return result;        
    }
}

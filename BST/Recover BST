# CODE:

```java
/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {

    private TreeNode first = null;
    private TreeNode last = null;
    private TreeNode middle = null;
    private TreeNode prev = new TreeNode(Integer.MIN_VALUE);

    public void recoverTree(TreeNode root) {
        // Find nodes causing violation in sorted inorder sequence
        inorder(root);

        // Swap node values back to restore BST property
        if (first != null && last != null) {
            // Case 1: Swapped nodes are not adjacent
            int temp = first.val;
            first.val = last.val;
            last.val = temp;
        } else if (first != null && middle != null) {
            // Case 2: Swapped nodes are adjacent
            int temp = first.val;
            first.val = middle.val;
            middle.val = temp;
        }
    }

    private void inorder(TreeNode root) {
        if (root == null) return;

        inorder(root.left);

        // Process current node: check for BST violation with prev node
        if (prev.val > root.val) {
            if (first == null) {
                // First violation found
                first = prev;
                middle = root;
            } else {
                // Second violation found
                last = root;
            }
        }
        
        // Move prev pointer forward
        prev = root;

        inorder(root.right);
    }
}

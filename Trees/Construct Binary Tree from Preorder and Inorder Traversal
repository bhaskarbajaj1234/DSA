# CODE:

import java.util.*;

/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public TreeNode buildTree(int[] preorder, int[] inorder) {
        // Step 1: Saare inorder elements ki index mapping store karo
        Map<Integer, Integer> inOrderMap = new HashMap<>();
        for (int i = 0; i < inorder.length; i++) {
            inOrderMap.put(inorder[i], i);
        }

        // Step 2: Recursive construction call
        return helper(preorder, 0, preorder.length - 1, 
                      inorder, 0, inorder.length - 1, 
                      inOrderMap);
    }

    private TreeNode helper(int[] preorder, int preStart, int preEnd, 
                           int[] inorder, int inStart, int inEnd, 
                           Map<Integer, Integer> inOrderMap) {

        // Base case: pointers cross kar gaye
        if (preStart > preEnd || inStart > inEnd) {
            return null;
        }

        // Preorder ka pehla element is current subtree root
        TreeNode root = new TreeNode(preorder[preStart]);

        // Find root's position in inorder array
        int inRoot = inOrderMap.get(root.val);

        // Count how many nodes lie in left subtree
        int numsLeft = inRoot - inStart;

        // Recursive call for Left and Right subtrees
        root.left = helper(preorder, preStart + 1, preStart + numsLeft, 
                           inorder, inStart, inRoot - 1, 
                           inOrderMap);

        root.right = helper(preorder, preStart + numsLeft + 1, preEnd, 
                            inorder, inRoot + 1, inEnd, 
                            inOrderMap);

        return root;
    }
}

# CODE:

/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public boolean isBalanced(TreeNode root) {
        // Agar check() -1 return na kare, matlab tree balanced hai
        return check(root) != -1;
    }

    private int check(TreeNode root) {
        // Base case: null node ki height 0 hoti hai
        if (root == null) {
            return 0;
        }

        // Left subtree ki height calculate karo
        int lh = check(root.left);
        // Right subtree ki height calculate karo
        int rh = check(root.right);

        // Agar koi bhi subtree already unbalanced mila ho toh turant -1 return karo
        if (lh == -1 || rh == -1) {
            return -1;
        }

        // Current node par balance condition check karo
        if (Math.abs(lh - rh) > 1) {
            return -1;
        }

        // Balanced hai toh normal height return karo
        return 1 + Math.max(lh, rh);
    }
}

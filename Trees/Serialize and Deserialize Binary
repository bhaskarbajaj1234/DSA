# CODE:

import java.util.*;

/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode(int x) { val = x; }
 * }
 */
public class Codec {

    // Encodes a tree to a single string using BFS.
    public String serialize(TreeNode root) {
        if (root == null) return "";

        StringBuilder sb = new StringBuilder();
        Queue<TreeNode> q = new LinkedList<>();
        q.offer(root);

        while (!q.isEmpty()) {
            TreeNode node = q.poll();

            // Null node ko sentinel '#' se mark karo
            if (node == null) {
                sb.append("#,");
            } else {
                sb.append(node.val).append(",");
                // Children ko directly offer karo (nulls will be captured next)
                q.offer(node.left);
                q.offer(node.right);
            }
        }
        return sb.toString();
    }

    // Decodes your encoded data to tree using BFS.
    public TreeNode deserialize(String data) {
        if (data == null || data.isEmpty()) return null;

        String[] values = data.split(",");
        TreeNode root = new TreeNode(Integer.parseInt(values[0]));

        Queue<TreeNode> q = new LinkedList<>();
        q.offer(root);

        int i = 1;

        while (!q.isEmpty() && i < values.length) {
            TreeNode curr = q.poll();

            // Left Child reconstruction
            if (!values[i].equals("#")) {
                TreeNode leftchild = new TreeNode(Integer.parseInt(values[i]));
                curr.left = leftchild;
                q.offer(leftchild);
            }
            i++;

            // Right Child reconstruction
            if (i < values.length && !values[i].equals("#")) {
                TreeNode rightchild = new TreeNode(Integer.parseInt(values[i]));
                curr.right = rightchild;
                q.offer(rightchild);
            }
            i++;
        }
        return root;
    }
}


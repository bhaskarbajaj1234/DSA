# CODE:

```java
import java.util.ArrayDeque;
import java.util.ArrayList;
import java.util.Deque;
import java.util.List;

/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public List<Integer> postorderTraversal(TreeNode root) {
        // Output list to store postorder sequence
        List<Integer> result = new ArrayList<>();
        // Single stack for explicit traversal tracking
        Deque<TreeNode> stack = new ArrayDeque<>();

        TreeNode curr = root;

        while (curr != null || !stack.isEmpty()) {
            if (curr != null) {
                // Keep pushing nodes and move to extreme left
                stack.push(curr);
                curr = curr.left;
            } else {
                // Check right child of the node on top of stack
                TreeNode temp = stack.peek().right;

                if (temp == null) {
                    // Node has no right child, process it
                    temp = stack.pop();
                    result.add(temp.val);

                    // Backtrack up as long as we are returning from right subtree
                    while (!stack.isEmpty() && temp == stack.peek().right) {
                        temp = stack.pop();
                        result.add(temp.val);
                    }
                } else {
                    // Process right subtree first
                    curr = temp;
                }
            }
        }

        return result;
    }
}

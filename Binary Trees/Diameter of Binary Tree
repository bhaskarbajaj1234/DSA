# CODE:

/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public int diameterOfBinaryTree(TreeNode root) {
        int[] result = new int[1];
        helper(root, result);
        return result[0];
    }

    private int helper(TreeNode root, int[] result) {
        // Base case: null node has 0 height
        if (root == null) {
            return 0;
        }

        // Left aur Right subtrees ki height calculate karo
        int lh = helper(root.left, result);
        int rh = helper(root.right, result);

        // Current node as the highest point of path: update max diameter
        result[0] = Math.max(result[0], lh + rh);

        // Return height to parent call
        return 1 + Math.max(lh, rh);
    }
}

# CODE:

import java.util.*;

/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int data;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode(int val) { data = val; left = null; right = null; }
 * }
 **/

class Solution {
    public int timeToBurnTree(TreeNode root, int start) {
        if (root == null) return 0;

        // Step 1: Upward pointers build karo aur start node locate karo
        Map<TreeNode, TreeNode> parentMap = new HashMap<>();
        TreeNode targetNode = buildParentAndFindStart(root, null, parentMap, start);

        // Step 2: BFS setup
        Queue<TreeNode> q = new LinkedList<>();
        Set<TreeNode> visited = new HashSet<>();

        q.offer(targetNode);
        visited.add(targetNode);

        int time = 0;

        // Step 3: Radial BFS
        while (!q.isEmpty()) {
            int levelSize = q.size();
            boolean flag = false;

            for (int i = 0; i < levelSize; i++) {
                TreeNode curr = q.poll();

                // Direction 1: Left Child
                if (curr.left != null && visited.add(curr.left)) {
                    flag = true;
                    q.offer(curr.left);
                }
                // Direction 2: Right Child
                if (curr.right != null && visited.add(curr.right)) {
                    flag = true;
                    q.offer(curr.right);
                }
                // Direction 3: Parent Node
                TreeNode parent = parentMap.get(curr);
                if (parent != null && visited.add(parent)) {
                    flag = true;
                    q.offer(parent);
                }
            }

            // Sirf tab time badhao jab nayi nodes infect hui hon
            if (flag) {
                time++;
            }
        }

        return time;
    }

    private TreeNode buildParentAndFindStart(TreeNode node, TreeNode parent, Map<TreeNode, TreeNode> parentMap, int start) {
        if (node == null) return null;

        parentMap.put(node, parent);

        TreeNode target = null;
        if (node.data == start) {
            target = node;
        }

        TreeNode left = buildParentAndFindStart(node.left, node, parentMap, start);
        TreeNode right = buildParentAndFindStart(node.right, node, parentMap, start);

        return target != null ? target : (left != null ? left : right);
    }
}

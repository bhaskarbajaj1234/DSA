# CODE:

import java.util.*;

/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public TreeNode buildTree(int[] inorder, int[] postorder) {
        // Step 1: Inorder array ke indices hashmap me store karo
        Map<Integer, Integer> inMap = new HashMap<>();
        for (int i = 0; i < inorder.length; i++) {
            inMap.put(inorder[i], i);
        }

        // Step 2: Recursive helper call
        return helper(inorder, 0, inorder.length - 1, 
                      postorder, 0, postorder.length - 1, 
                      inMap);
    }

    private TreeNode helper(int[] inorder, int inStart, int inEnd, 
                           int[] postorder, int postStart, int postEnd, 
                           Map<Integer, Integer> inMap) {

        // Base case: pointers cross kar gaye
        if (inStart > inEnd || postStart > postEnd) {
            return null;
        }

        // Postorder ka last element current subtree ka root hota hai
        TreeNode root = new TreeNode(postorder[postEnd]);

        // Inorder me root ka index dhoondho
        int inRoot = inMap.get(root.val);

        // Left subtree me kitne nodes aayenge
        int numsLeft = inRoot - inStart;

        // Recursive call for Left Subtree
        root.left = helper(inorder, inStart, inRoot - 1, 
                           postorder, postStart, postStart + numsLeft - 1, 
                           inMap);

        // Recursive call for Right Subtree
        root.right = helper(inorder, inRoot + 1, inEnd, 
                            postorder, postStart + numsLeft, postEnd - 1, 
                            inMap);

        return root;
    }
}

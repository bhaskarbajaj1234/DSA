# CODE:

import java.util.*;

/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {

    class Pair {
        TreeNode node;
        int idx;
        Pair(TreeNode node, int idx) {
            this.node = node;
            this.idx = idx;
        }
    }

    public int widthOfBinaryTree(TreeNode root) {
        if (root == null) return 0;

        int maxWidth = 0;
        Queue<Pair> q = new LinkedList<>();
        q.offer(new Pair(root, 0));

        while (!q.isEmpty()) {
            int levelSize = q.size();
            
            // Current level ke first element ka index pick karo
            int startLevelIndex = q.peek().idx;
            int first = 0;
            int last = 0;

            for (int i = 0; i < levelSize; i++) {
                Pair curr = q.poll();
                TreeNode currNode = curr.node;

                // Overflow prevention: subtract base index of current level
                int currIndex = curr.idx - startLevelIndex;

                if (i == 0) first = currIndex;
                if (i == levelSize - 1) last = currIndex;

                if (currNode.left != null) {
                    q.offer(new Pair(currNode.left, 2 * currIndex + 1));
                }
                if (currNode.right != null) {
                    q.offer(new Pair(currNode.right, 2 * currIndex + 2));
                }
            }

            maxWidth = Math.max(maxWidth, last - first + 1);
        }

        return maxWidth;
    }
}

# CODE:

import java.util.*;

/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {

    class Point {
        int val, row, col;
        Point(int val, int row, int col) {
            this.val = val;
            this.row = row;
            this.col = col;
        }
    }

    public List<List<Integer>> verticalTraversal(TreeNode root) {
        List<Point> points = new ArrayList<>();

        // Step 1: Har node ke coordinates (row, col) collect karo
        traverse(root, 0, 0, points);

        // Step 2: 3-tier custom comparator se sort karo
        Collections.sort(points, (a, b) -> {
            if (a.col != b.col) return a.col - b.col; // 1. Leftmost column pehle
            if (a.row != b.row) return a.row - b.row; // 2. Top-most row pehle
            return a.val - b.val;                     // 3. Overlap par smaller value pehle
        });

        // Step 3: Column-wise group karo (LinkedHashMap insertion order preserve karega)
        Map<Integer, List<Integer>> map = new LinkedHashMap<>();
        for (Point p : points) {
            if (!map.containsKey(p.col)) {
                map.put(p.col, new ArrayList<>());
            }
            map.get(p.col).add(p.val);
        }

        return new ArrayList<>(map.values());
    }

    private void traverse(TreeNode root, int row, int col, List<Point> points) {
        if (root == null) return;

        points.add(new Point(root.val, row, col));

        traverse(root.left, row + 1, col - 1, points);
        traverse(root.right, row + 1, col + 1, points);
    }
}
